// Prisma schema for AIVOLV Attendance & Management
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Access control
// ===========================================================================

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  // Higher level = more privileged (e.g. Super Admin = 100).
  level       Int     @default(0)
  // System roles are protected from deletion/edits by the app layer.
  isSystem    Boolean @default(false)

  users           User[]
  rolePermissions RolePermission[]
  announcements   Announcement[]
  documentAccess  DocumentRoleAccess[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  name        String
  // Machine-readable key, e.g. "employees.create".
  key         String  @unique
  description String?
  // Logical grouping/module, e.g. "employees", "attendance".
  module      String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ===========================================================================
// Identity
// ===========================================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String?   @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  // Brute-force protection.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Optional 1:1 link to an employee profile.
  employee Employee?

  sessions          Session[]
  loginAttempts     LoginAttempt[]
  authorizedDevices AuthorizedDevice[]
  authorizedIps     AuthorizedIp[]
  auditLogs         AuditLog[]

  attendancesCreated             Attendance[]           @relation("AttendanceCreatedBy")
  attendancesUpdated             Attendance[]           @relation("AttendanceUpdatedBy")
  attendanceCorrectionsRequested AttendanceCorrection[] @relation("CorrectionRequestedBy")
  attendanceCorrectionsReviewed  AttendanceCorrection[] @relation("CorrectionReviewedBy")
  leaveRequestsApproved          LeaveRequest[]         @relation("LeaveApprovedBy")
  tasksAssigned                  Task[]                 @relation("TasksAssignedBy")
  taskComments                   TaskComment[]
  taskFilesUploaded              TaskFile[]
  taskLinksCreated               TaskLink[]             @relation("TaskLinksCreated")
  announcementsCreated           Announcement[]         @relation("AnnouncementsCreatedBy")
  announcementReads              AnnouncementRead[]
  documentsUploaded              Document[]             @relation("DocumentsUploadedBy")
  documentsVerified              Document[]             @relation("DocumentsVerifiedBy")
  documentsRequested             Document[]             @relation("DocumentsRequestedBy")
  backupsTriggered               BackupHistory[]        @relation("BackupsTriggeredBy")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([roleId])
  @@map("users")
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  lastActivityAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id         String  @id @default(cuid())
  // The email/username that was entered (may not match a real user).
  identifier String
  success    Boolean @default(false)
  ipAddress  String?
  userAgent  String?
  reason     String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([identifier])
  @@index([userId])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")
}

// ===========================================================================
// Organization
// ===========================================================================

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String? @unique
  description String?
  isActive    Boolean @default(true)

  employees     Employee[]
  designations  Designation[]
  announcements Announcement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@map("departments")
}

model Designation {
  id          String  @id @default(cuid())
  title       String
  description String?
  isActive    Boolean @default(true)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  employees Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([title, departmentId])
  @@index([departmentId])
  @@index([isActive])
  @@map("designations")
}

model Employee {
  id            String  @id @default(cuid())
  employeeCode  String  @unique
  firstName     String
  middleName    String?
  lastName      String
  // Work email (unique) and optional personal email.
  email         String? @unique
  personalEmail String?
  phone         String?

  // Personal details
  dateOfBirth   DateTime?      @db.Date
  gender        Gender?
  maritalStatus MaritalStatus?

  // Address
  addressLine String?
  city        String?
  state       String?
  postalCode  String?
  country     String?

  // Job details
  employmentType     EmploymentType @default(FULL_TIME)
  dateOfJoining      DateTime?      @db.Date
  isActive           Boolean        @default(true)
  assignedDeviceName String?

  // Salary, Hike & Bank Details
  currentGrossSalary Float?
  netTakeHome        Float?
  lastHikeDate       DateTime? @db.Date
  hikePercentage     Float?
  revisedGrossSalary Float?
  effectiveDate      DateTime? @db.Date
  bankAccountNumber  String?
  bankIfscCode       String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  emergencyContacts     EmergencyContact[]
  attendances           Attendance[]
  attendanceCorrections AttendanceCorrection[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]
  tasksAssigned         Task[]                 @relation("TaskAssignee")
  taskAssignments       TaskAssignee[]
  documents             Document[]
  workLogs              WorkLog[]

  // Optional 1:1 link back to a login account.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([departmentId])
  @@index([designationId])
  @@index([isActive])
  @@map("employees")
}

model EmergencyContact {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  email        String?
  addressLine  String?
  isPrimary    Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([employeeId])
  @@map("emergency_contacts")
}

// ===========================================================================
// Attendance
// ===========================================================================

model Attendance {
  id              String           @id @default(cuid())
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime         @db.Date
  checkIn         DateTime?
  checkOut        DateTime?
  lunchBreakStart DateTime?
  lunchBreakEnd   DateTime?
  teaBreakStart   DateTime?
  teaBreakEnd     DateTime?
  reCheckInStatus ReCheckInStatus  @default(NONE)
  reCheckInReason String?
  totalMinutes    Int              @default(0)
  status          AttendanceStatus @default(ABSENT)
  lateMinutes     Int              @default(0)
  overtimeMinutes Int              @default(0)
  ipAddress       String?
  deviceId        String?
  remarks         String?

  // Audit of who recorded / last changed this row.
  createdById String?
  createdBy   User?   @relation("AttendanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("AttendanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  corrections AttendanceCorrection[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // One attendance record per employee per day.
  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@index([employeeId])
  @@map("attendance")
}

model AttendanceCorrection {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Proposed values for the correction.
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  requestedStatus   AttendanceStatus?
  reason            String
  remarks           String?

  status CorrectionStatus @default(PENDING)

  requestedById String?
  requestedBy   User?     @relation("CorrectionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    User?     @relation("CorrectionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  // Admin comment on approve; required rejection reason when status is REJECTED.
  reviewComment String?

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attendanceId])
  @@index([employeeId])
  @@index([status])
  @@map("attendance_corrections")
}

model AttendanceSettings {
  id String @id @default(cuid())

  // Office hours, 24h "HH:mm".
  officeStartTime String @default("09:30")
  officeEndTime   String @default("18:30")

  // Thresholds (in minutes).
  graceMinutes   Int @default(12)
  fullDayMinutes Int @default(540)
  halfDayMinutes Int @default(270)

  // Overtime rules.
  overtimeEnabled          Boolean @default(false)
  overtimeThresholdMinutes Int     @default(540)
  overtimeDailyCapMinutes  Int?
  overtimeRate             Float   @default(1.0)

  // Days of week counted as working days (0 = Sunday .. 6 = Saturday).
  workingDays Int[]  @default([1, 2, 3, 4, 5])
  timezone    String @default("Asia/Kolkata")

  createdById String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendance_settings")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReCheckInStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

// ===========================================================================
// Leave management
// ===========================================================================

model LeaveType {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  description String?
  // Annual entitlement in days (supports 0.5 for half-day tracking).
  annualQuota Float   @default(0)
  isPaid      Boolean @default(true)
  isActive    Boolean @default(true)

  balances LeaveBalance[]
  requests LeaveRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@map("leave_types")
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  // Calendar year the balance applies to.
  year        Int
  // Days allocated to this employee (may differ from the type default).
  allocated   Float     @default(0)
  used        Float     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([year])
  @@map("leave_balances")
}

model LeaveRequest {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  fromDate DateTime @db.Date
  toDate   DateTime @db.Date

  // When true, `fromDate` and `toDate` must be the same calendar day.
  isHalfDay     Boolean        @default(false)
  halfDayPeriod HalfDayPeriod?

  reason String
  status LeaveRequestStatus @default(PENDING)

  approvedById    String?
  approvedBy      User?     @relation("LeaveApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([fromDate])
  @@index([toDate])
  @@map("leave_requests")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HalfDayPeriod {
  FIRST_HALF
  SECOND_HALF
}

// ===========================================================================
// Holiday calendar (IST)
// ===========================================================================

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @db.Date
  description String?
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([isActive])
  @@map("holidays")
}

// ===========================================================================
// Tasks, announcements, documents, payroll
// ===========================================================================

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id                String       @id @default(cuid())
  title             String
  description       String?
  assigneeId        String
  assignee          Employee     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedById      String?
  assignedBy        User?        @relation("TasksAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  givenDate         DateTime?    @db.Date
  dueDate           DateTime?    @db.Date
  status            TaskStatus   @default(TO_DO)
  priority          TaskPriority @default(MEDIUM)
  recurringInterval String?
  completedAt       DateTime?

  comments  TaskComment[]
  files     TaskFile[]
  links     TaskLink[]
  assignees TaskAssignee[]
  workLogs  WorkLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model TaskComment {
  id       String @id @default(cuid())
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([authorId])
  @@map("task_comments")
}

model TaskFile {
  id           String  @id @default(cuid())
  taskId       String
  task         Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  fileName     String
  storedName   String
  mimeType     String?
  sizeBytes    Int

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([uploadedById])
  @@map("task_files")
}

model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([taskId, employeeId])
  @@index([employeeId])
  @@map("task_assignees")
}

model TaskLink {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label       String?
  url         String
  createdById String?
  createdBy   User?    @relation("TaskLinksCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@map("task_links")
}

model WorkLog {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  logDate     DateTime @db.Date
  hours       Float
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([employeeId])
  @@index([logDate])
  @@map("work_logs")
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String
  isActive    Boolean              @default(true)
  publishedAt DateTime             @default(now())
  expiresAt   DateTime?
  audience    AnnouncementAudience @default(ALL)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("AnnouncementsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  reads AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([publishedAt])
  @@index([audience])
  @@index([departmentId])
  @@index([roleId])
  @@map("announcements")
}

enum AnnouncementAudience {
  ALL
  DEPARTMENT
  ROLE
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
  @@map("announcement_reads")
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentSource {
  ADMIN
  EMPLOYEE
}

enum DocumentVisibility {
  EMPLOYEE
  ADMIN_ONLY
  ROLE_RESTRICTED
}

model Document {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title       String
  category    String?
  description String?

  fileName   String?
  storedName String?
  mimeType   String?
  sizeBytes  Int?

  source             DocumentSource             @default(ADMIN)
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?                      @relation("DocumentsVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectionReason    String?

  isRequest     Boolean   @default(false)
  requestedAt   DateTime?
  requestedById String?
  requestedBy   User?     @relation("DocumentsRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  visibility DocumentVisibility   @default(EMPLOYEE)
  roleAccess DocumentRoleAccess[]

  uploadedById String?
  uploadedBy   User?   @relation("DocumentsUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([verificationStatus])
  @@index([source])
  @@index([visibility])
  @@index([isRequest])
  @@map("documents")
}

model DocumentRoleAccess {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([documentId, roleId])
  @@index([documentId])
  @@index([roleId])
  @@map("document_role_access")
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  READY
  PAID
}

model PayrollRun {
  id            String           @id @default(cuid())
  // Calendar month, e.g. 2026-07
  month         String           @unique
  status        PayrollRunStatus @default(DRAFT)
  employeeCount Int?
  notes         String?
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payroll_runs")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum MaritalStatus {
  SINGLE
  MARRIED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

// ===========================================================================
// Configuration & security
// ===========================================================================

model Setting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String?
  // Hint for how to parse `value`: string | number | boolean | json.
  type        String  @default("string")
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuthorizedDevice {
  id               String    @id @default(cuid())
  // Stable identifier/fingerprint for the device.
  deviceIdentifier String    @unique
  name             String?
  userAgent        String?
  isActive         Boolean   @default(true)
  lastSeenAt       DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@map("authorized_devices")
}

model AuthorizedIp {
  id        String  @id @default(cuid())
  // Single IP or CIDR range, e.g. 192.168.1.0/24.
  ipAddress String  @unique
  label     String?
  isActive  Boolean @default(true)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@map("authorized_ips")
}

enum BackupOperation {
  BACKUP
  RESTORE
}

enum BackupType {
  MANUAL
  SCHEDULED
}

enum BackupStatus {
  RUNNING
  COMPLETED
  FAILED
}

model BackupHistory {
  id               String          @id @default(cuid())
  operation        BackupOperation @default(BACKUP)
  type             BackupType      @default(MANUAL)
  status           BackupStatus    @default(RUNNING)
  fileName         String?
  filePath         String?
  sizeBytes        Int?
  databaseIncluded Boolean         @default(true)
  filesIncluded    Boolean         @default(true)
  errorMessage     String?
  startedAt        DateTime        @default(now())
  completedAt      DateTime?

  sourceBackupId String?
  sourceBackup   BackupHistory?  @relation("RestoreSource", fields: [sourceBackupId], references: [id], onDelete: SetNull)
  restores       BackupHistory[] @relation("RestoreSource")

  triggeredById String?
  triggeredBy   User?   @relation("BackupsTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([operation])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("backup_history")
}

model AuditLog {
  id          String  @id @default(cuid())
  action      String
  // The entity type affected, e.g. "Employee".
  entity      String?
  entityId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Audit logs are immutable — only a creation timestamp.
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
